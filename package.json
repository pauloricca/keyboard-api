{
  "name": "keyboard-svg-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && esbuild src/editor.ts --bundle --format=esm --target=es2022 --outfile=dist/editor.bundle.js",
    "start": "node dist/server.js",
    "dev": "npm run build && tsx watch src/server.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tonaljs/chord-type": "^5.1.1",
    "@tonaljs/note": "^4.12.1",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
